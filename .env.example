# Copy to .env (gitignored) and fill in. Never commit the filled-in copy.
# Used by `uvicorn` locally (the app reads .env from the folder you run it in) and by
# docker-compose (env_file). In Kubernetes these come from the Helm values and a
# Secret instead, see deploy/helm/mosaic-common-service/values-prod.yaml.example.

# --- SharePoint (the /sharepoint/* endpoints) -------------------------------
# The folder every request path is relative to: its browser URL.
GATEWAY_SHAREPOINT_ROOT_URL=https://contoso.sharepoint.com/sites/Team/Shared Documents/Reports
# The Entra ID app registration the service signs in as.
GATEWAY_SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000
GATEWAY_SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SECRET. The only value here that must never leave your machine.
GATEWAY_SHAREPOINT_CLIENT_SECRET=
# true = no writes or deletes, reads and listing only.
GATEWAY_SHAREPOINT_READ_ONLY=false

# --- Redshift (the /query endpoint) -----------------------------------------
GATEWAY_REDSHIFT_HOST=
